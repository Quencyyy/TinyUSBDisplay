<Window x:Class="MiniDisplay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tiny USB Display" Width="620" Height="500" MinWidth="560" MinHeight="440">
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="18" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0">
      <TextBlock Text="Tiny USB Display" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18" />
      <TextBlock Text="裝置" />
      <ComboBox x:Name="PortBox" Height="30" Margin="0,5,0,12" IsEditable="True" />
      <Button Content="選擇 PNG / JPG / BMP" Height="34" Click="SelectImage_Click" />
      <TextBlock x:Name="FileLabel" Text="尚未選擇圖片" TextTrimming="CharacterEllipsis" Margin="0,6,0,14" />

      <TextBlock Text="縮放方式" />
      <ComboBox x:Name="ResizeBox" Height="30" Margin="0,5,0,12" SelectionChanged="Options_Changed">
        <ComboBoxItem Content="Fit" IsSelected="True" />
        <ComboBoxItem Content="Fill" />
        <ComboBoxItem Content="Stretch" />
      </ComboBox>
      <TextBlock Text="旋轉" />
      <ComboBox x:Name="RotationBox" Height="30" Margin="0,5,0,18" SelectionChanged="Options_Changed">
        <ComboBoxItem Content="0°" IsSelected="True" />
        <ComboBoxItem Content="90°" />
        <ComboBoxItem Content="180°" />
        <ComboBoxItem Content="270°" />
      </ComboBox>

      <Button x:Name="StartButton" Content="開始顯示" Height="36" Click="Start_Click" />
      <Button x:Name="StopButton" Content="停止" Height="32" Margin="0,8,0,0" Click="Stop_Click" IsEnabled="False" />
      <TextBlock x:Name="StatusLabel" Text="未連線" Margin="0,14,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Column="2" Background="#171717" CornerRadius="8" Padding="16">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="LCD 預覽（160 × 80）" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12" />
        <Border Background="Black" BorderBrush="#555" BorderThickness="1" HorizontalAlignment="Center">
          <Image x:Name="PreviewImage" Width="320" Height="160" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</Window>
